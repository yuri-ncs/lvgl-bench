CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# caches no máximo: o LVGL roda da flash, e o v9 tem mais código
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
# o loop de medida não cede a CPU
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
# símbolos LVGL com o mesmo nome no 8 e no 9
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y
# printf sai pela USB-C (USB-Serial-JTAG nativa do S3; a placa nao tem conversor UART)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# 3.5 KB do padrão estoura na cena "ui" com o LVGL em FreeRTOS
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
