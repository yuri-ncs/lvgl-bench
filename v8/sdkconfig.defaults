# byte swap done in the i80 hardware, as in v9
CONFIG_LV_COLOR_16_SWAP=n
# libc malloc/memcpy, as in v9
CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_MEMCPY_MEMSET_STD=y
# v8 with 16-bit color needs this for transform_* on non-image objects;
# without it it silently skips the object (v9 does not need it)
CONFIG_LV_COLOR_SCREEN_TRANSP=y
