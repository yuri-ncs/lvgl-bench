# troca de bytes feita no hardware i80, como no v9
CONFIG_LV_COLOR_16_SWAP=n
# malloc/memcpy da libc, como no v9
CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_MEMCPY_MEMSET_STD=y
# v8 com cor de 16 bits precisa disso para transform_* em objetos que não são imagem;
# sem isso ele pula o objeto em silêncio (o v9 não precisa)
CONFIG_LV_COLOR_SCREEN_TRANSP=y
